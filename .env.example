# Copy to .env and fill in. .env is gitignored and must never be committed.
# Spec Section 11: API keys are held server-side, outside source files and
# saved run artifacts.

ANTHROPIC_API_KEY=

# One model version is used throughout, for extraction (Step 3) and support
# verification (Step 5) alike, and for evaluation and demonstration alike.
# Spec Section 11. Changing this invalidates comparability with prior runs.
UM_MODEL=claude-sonnet-5

# Execution is sequential. Concurrency is not implemented in this build and
# this policy is fixed for the duration of the experiment, because latency
# conclusions depend on it. Spec Section 11.
UM_MAX_RETRIES=2
UM_REQUEST_TIMEOUT_SECONDS=120

# Deliberately not configurable here: the prompt version and the criteria set
# version. Both are provenance rather than settings, and both are read from
# the artifact that produced them — prompts.py and criteria_sets.json — so a
# run log records what actually ran.
#
# An earlier version of this file carried UM_PROMPT_VERSION=v1 while the code
# read extraction/1.0.0. Nothing consumed it, so nothing broke, but had
# anything done so every run would have been filed under a prompt version that
# did not exist. A provenance field that can disagree with the thing it
# describes is worse than no field at all: it makes the log confidently wrong
# rather than silent.
